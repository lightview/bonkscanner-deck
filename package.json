{
  "name": "bonkscanner-deck",
  "version": "0.3.0",
  "description": "Megabonk map reroll automation for Steam Deck, ported from BonkScanner",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "package": "npm run build && python tools/package.py"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "megabonk"
  ],
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "author": "autolight",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lightview/bonkscanner-deck.git"
  },
  "homepage": "https://github.com/lightview/bonkscanner-deck#readme"
}
